{
	"name": "dust-lib",
	"version": "0.5.0",
	"description": "Random helper functions for the daily life",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/charlyoleg2/dust-mono.git"
	},
	"homepage": "https://charlyoleg2.github.io/dust-mono/",
	"author": "charlyoleg",
	"license": "ISC",
	"keywords": [
		"random helper functions",
		"loan calculation"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"tsdown": {
		"entry": [
			"src/index.ts"
		],
		"format": "esm",
		"splitting": false,
		"dts": true,
		"sourcemap": true,
		"clean": true
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "none",
		"printWidth": 100,
		"plugins": [],
		"overrides": []
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"pretty": "prettier --check .",
		"format": "prettier --write .",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test:unit:once": "vitest --run",
		"ci": "run-s check build pretty lint test:unit:once",
		"clean": "rimraf dist dist2 node_modules"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/eslint__js": "^8.42.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"npm-run-all2": "^9.0.3",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"tsdown": "^0.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5"
	}
}
